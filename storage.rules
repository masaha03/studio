rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow read and write access to all files for authenticated users.
    // Consider restricting access to user-specific folders for better security.
    // e.g., match /users/{userId}/{allPaths=**} {
    //   allow read, write: if request.auth != null && request.auth.uid == userId;
    // }
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
